YR-MISSION-RULES/1

[rules]
schema=2
minimumEngine=2
revision=2

; Exact difficulty record keys. Native trigger validation remains mandatory.
[labels]
EASY=简单
WINEASY=简单
NORMAL=普通
WINNORMAL=普通
WINPT=普通
HARD=困难
WINHARD=困难
WINKN=困难
BRUTAL=残虐
WINBRUTAL=残虐
WINCN=残虐
HELL=地狱
WINHELL=地狱
WINDY=地狱
EXTREME=极限
WINEXTREME=极限

; Matching data is signed and independently versioned. No code or addresses.
[matching]
recordPrefix=kk_save_
slotSuffix=_p
familyPrefix=WIN
labelSuffixes=模式|难度
labelPrefixes=开启|选择|进入
numberedPrefixes=难度|难
ordinalTokens=一|二|三|四|五|六|七|八|九|十
numberLabel=难度
defaultLabel=默认难度
customLabel=自定义 · 
labelOrder=简单|普通|困难|残虐|地狱|极限
maxNumber=99
inferSelectorLabels=1
inferDefaultRoute=1

; Verified numbered difficulty records, merged across native player slots.
[map:11a6f8209b480c35]
kk_save_SL_p0=SL|默认难度
kk_save_SL_p2=SL|默认难度
kk_save_NDY_p0=NDY|难度1
kk_save_NDY_p2=NDY|难度1
kk_save_ND2_p0=ND2|难度2
kk_save_ND2_p2=ND2|难度2
kk_save_NDS_p0=NDS|难度3
kk_save_NDS_p2=NDS|难度3
kk_save_ND4_p0=ND4|难度4
kk_save_ND4_p2=ND4|难度4
kk_save_ND5_p0=ND5|难度5
kk_save_ND5_p2=ND5|难度5
kk_save_ND6_p0=ND6|难度6
kk_save_ND6_p2=ND6|难度6
